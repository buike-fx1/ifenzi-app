# Copy this file to ".env" and edit the values before your first run.
# (If you skip this, the app still works with safe defaults shown below.)

PORT=3000

# First-run admin login (only used the very first time the server starts
# and creates the database — changing this afterwards does nothing; use
# Admin > Settings > Change Password instead).
ADMIN_USER=admin
ADMIN_PASS=ifenzi2026

# Random long string used to sign login sessions. Change this to any
# random text before putting the site online.
SESSION_SECRET=change-this-to-a-long-random-string
